  <!-- Vendor (QCOM Vendor) -->
  <remove-project name="AOSPA/android_vendor_nxp_opensource_keymaster" />
  <project path="vendor/nxp/opensource/keymaster" name="TheDoctor12/android_vendor_nxp_opensource_keymaster" remote="github" revision="calcite" />
